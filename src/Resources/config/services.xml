<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <defaults autoconfigure="true"/>

        <service id="Waiter24\Export\Service\PluginConfig">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        </service>

        <service id="Waiter24\Export\Service\MenuExporter">
            <argument type="service" id="Waiter24\Export\Service\PluginConfig"/>
            <argument type="service" id="product.repository"/>
            <argument type="service" id="currency.repository"/>
            <argument type="service" id="logger"/>
        </service>

        <service id="Waiter24\Export\Service\RealtimeQueue">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        </service>

        <!-- Scheduled daily export task (handler auto-registered via #[AsMessageHandler]) -->
        <service id="Waiter24\Export\ScheduledTask\ExportTask">
            <tag name="shopware.scheduled.task"/>
        </service>

        <service id="Waiter24\Export\ScheduledTask\ExportTaskHandler">
            <argument type="service" id="scheduled_task.repository"/>
            <argument type="service" id="logger"/>
            <argument type="service" id="Waiter24\Export\Service\MenuExporter"/>
            <argument type="service" id="Waiter24\Export\Service\PluginConfig"/>
        </service>

        <!-- Debounced realtime push: a product write queues it (see the
             subscriber below); this task flushes the queue about once a minute. -->
        <service id="Waiter24\Export\ScheduledTask\RealtimePushTask">
            <tag name="shopware.scheduled.task"/>
        </service>

        <service id="Waiter24\Export\ScheduledTask\RealtimePushTaskHandler">
            <argument type="service" id="scheduled_task.repository"/>
            <argument type="service" id="logger"/>
            <argument type="service" id="Waiter24\Export\Service\RealtimeQueue"/>
            <argument type="service" id="Waiter24\Export\Service\MenuExporter"/>
            <argument type="service" id="Waiter24\Export\Service\PluginConfig"/>
        </service>

        <!-- Auto-tagged kernel.event_subscriber via autoconfigure (implements
             EventSubscriberInterface) -->
        <service id="Waiter24\Export\Subscriber\ProductWrittenSubscriber">
            <argument type="service" id="Waiter24\Export\Service\RealtimeQueue"/>
            <argument type="service" id="Waiter24\Export\Service\PluginConfig"/>
        </service>

        <!-- Manual export CLI command (auto-tagged console.command via autoconfigure) -->
        <service id="Waiter24\Export\Command\ExportCommand">
            <argument type="service" id="Waiter24\Export\Service\MenuExporter"/>
        </service>

        <!-- Cart bridge: storefront JSON endpoints the chat widget calls
             (routes imported via Resources/config/routes.xml) -->
        <service id="Waiter24\Export\Storefront\Controller\CartBridgeController" public="true">
            <argument type="service" id="Shopware\Core\Checkout\Cart\SalesChannel\CartService"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\LineItemFactoryRegistry"/>
            <argument type="service" id="Waiter24\Export\Service\PluginConfig"/>
            <tag name="controller.service_arguments"/>
        </service>
    </services>
</container>
