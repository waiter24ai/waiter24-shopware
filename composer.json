{
    "name": "waiter24/shopware-export",
    "description": "Export the Shopware 6 catalog to Waiter24 and embed the AI chat widget",
    "type": "shopware-platform-plugin",
    "license": "proprietary",
    "version": "1.3.1",
    "require": {
        "shopware/core": "~6.6.0"
    },
    "autoload": {
        "psr-4": {
            "Waiter24\\Export\\": "src/"
        }
    },
    "extra": {
        "shopware-plugin-class": "Waiter24\\Export\\Waiter24Export",
        "label": {
            "en-GB": "Waiter24 — catalog export & AI chat widget",
            "de-DE": "Waiter24 — Katalog-Export & KI-Chat-Widget"
        }
    }
}
